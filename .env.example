# API Key (必填)
ANTHROPIC_API_KEY=your-api-key-here

# 模型 ID (必填)
MODEL_ID=mimo-v2.5-pro

# 兼容提供商的 Base URL (必填, 使用非 Anthropic 提供商时)
ANTHROPIC_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic

# =============================================================================
#  兼容提供商配置 (取消注释即可使用)
#
#  提供商         MODEL_ID              Base URL
#  -------------  --------------------  -----------------------------------------
#  MiMo           mimo-v2.5-pro         https://token-plan-cn.xiaomimimo.com/anthropic
#  DeepSeek       deepseek-chat         https://api.deepseek.com/anthropic
#  GLM (智谱)     glm-5                 https://open.bigmodel.cn/api/anthropic
#  Kimi (月之暗面) kimi-k2.5             https://api.moonshot.cn/anthropic
#  MiniMax        MiniMax-M2.5          https://api.minimaxi.com/anthropic
# =============================================================================

# Fallback 模型 (可选, 连续 529 过载时自动切换)
# FALLBACK_MODEL=deepseek-chat

# 沙箱级别 (可选, s21)
# auto = 自动检测平台选最优方案 (默认)
# off  = 关闭沙箱，裸跑 (调试用)
# SANDBOX_LEVEL=auto
